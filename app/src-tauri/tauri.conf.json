{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "H-Mouse Config",
  "version": "0.1.5",
  "identifier": "io.github.ricardohipp.h-mouse-config",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "H-Mouse Config",
        "width": 1385,
        "height": 784,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
